# Copy this file to .env.local or run scripts/setup_local_env.ps1.
# Never commit .env.local or real API keys.

# Required for reliable SEC access.
SEC_USER_AGENT="Your Name your.email@example.com"

# MVP cost posture: Free, Lean, Stable, or Premium.
BUDGET_MODE="Lean"
BUDGET_POLICY_PATH="data/budget_modes.json"
BYOD_DATA_DIR="data/manual_import"

# Consensus, recommendations, and transcript/overview sources.
ALPHAVANTAGE_API_KEY=""
FINNHUB_API_KEY=""

# Macro attribution sources.
FRED_API_KEY=""
BLS_API_KEY=""
BEA_API_KEY=""
CENSUS_API_KEY=""

# Macro defaults.
ENABLE_DEFAULT_MACRO=true
GLOBAL_MACRO_MODE=false
ENABLE_GDELT=false

# Optional providers.
FMP_API_KEY=""
WISBURG_API_KEY=""
POLYGON_API_KEY=""
TIINGO_API_KEY=""
EODHD_API_KEY=""
NEWSAPI_API_KEY=""
EVENT_REGISTRY_API_KEY=""
EODHD_MAX_CALLS_PER_RUN=18
ENABLE_WISBURG=false
ENABLE_NEWS_INTELLIGENCE=true

# Optional IC Copilot / LLM thesis synthesis.
# ChatGPT Plus does not automatically provide API credits for this app.
ENABLE_LLM_THESIS=false
ENABLE_LLM_CLAIM_VALIDATION=false
ENABLE_LLM_SOURCE_AGENT=false
ENABLE_SECONDARY_LLM_REVIEW=true
SECONDARY_LLM_MIN_STAGE="Research-Ready"
LLM_LANGUAGE_POLICY="bilingual_audit"
LLM_PRIMARY_PROFILE_ID=""
LLM_SECONDARY_PROFILE_ID=""
LLM_PROVIDER="deepseek"
LLM_MODEL="deepseek-v4-pro"
LLM_BASE_URL=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
QWEN_API_KEY=""
KIMI_API_KEY=""
DEEPSEEK_API_KEY=""
ENABLE_HYBRID_RESEARCH=false
ALLOW_OWNER_FUNDED_HYBRID=false
ENABLE_LOCAL_CODEX_EXECUTOR=false
CODEX_EVENT_STREAM_EXECUTION=true
CODEX_STARTUP_TIMEOUT_SECONDS=60
CODEX_QUIET_AFTER_SECONDS=180
HYBRID_OPENAI_MODEL="gpt-5.6-sol"
HYBRID_DEEPSEEK_MODEL="deepseek-v4-pro"
HYBRID_RESEARCH_TIMEOUT_SECONDS=900
# Bounded repair-only execution. Completed stage outputs are checkpointed, so
# reconnecting or restarting does not repeat a successful model call.
REPAIR_REVISION_TIMEOUT_SECONDS=300
REPAIR_CLOSURE_TIMEOUT_SECONDS=480
REPAIR_CLOSURE_RETRY_TIMEOUT_SECONDS=1200
REPAIR_TOTAL_TIMEOUT_SECONDS=900
REPAIR_TOTAL_RETRY_TIMEOUT_SECONDS=1500
HYBRID_CODEX_CLOSURE_REASONING_EFFORT=medium
REPAIR_MAX_TRANSIENT_RETRIES=1
HYBRID_DEEPSEEK_REASONING_EFFORT="high"
HYBRID_DEEPSEEK_THINKING=true
HYBRID_DEEPSEEK_MAX_TOKENS=12000
HYBRID_SOL_REASONING_EFFORT="max"
HYBRID_SOL_MAX_OUTPUT_TOKENS=16000
QUALITY_BENCHMARK_REVIEW_MULTIPLE=2.0
CODEX_EXECUTABLE="codex"
